APP_NAME=MySmyle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central "landlord" database. Each tenant gets its own database + scoped MySQL
# user, provisioned at runtime (see config/tenancy.php) — nothing to set here.
DB_CONNECTION=landlord
# 'mariadb' or 'mysql' — must match your server engine.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mysmyle_landlord
DB_USERNAME=root
DB_PASSWORD=

# Host part of the per-tenant MySQL accounts (mysmyle_t{id}@<host>).
TENANT_DB_USER_HOST=%

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# SPA auth (Sanctum). Must list the frontend origin(s).
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tenant provisioning runs on the queue — a worker must be running.
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# Outbound email — provisioning welcome, set-password link, temporary passwords.
# Delivered via the queue, so a worker must be running.
# Dev: "log" writes rendered emails to storage/logs/laravel.log.
# Prod: set MAIL_MAILER=smtp and fill in the host/credentials below.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@mysmyle.clinic"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legacy VDC source for the one-time `legacy:import`. Point LEGACY_DB_USERNAME at a
# SELECT-only MySQL user — the importer never writes to this connection.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
